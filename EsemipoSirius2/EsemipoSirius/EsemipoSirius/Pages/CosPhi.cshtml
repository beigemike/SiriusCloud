@page
@model EsemipoSirius.Pages.CosPhiModel
@{
}

<form action="/CosPhi" method="get">
    <select name="NomeDevice">
        @foreach (var dispositivo in @Model.NomiDispositivi)
        {
            <option value=@dispositivo>@dispositivo</option>
        }
    </select>
    <br />
    <input type="submit" value="Submit" class="submit" />
</form>


<div>
    @Model.media
</div>


<div>
    <canvas id="graficoCosPhi" width="400" height="400"></canvas>
</div>

    <script>

        let dataCosPhi = {
                datasets: [{
            backgroundColor: [
                '#00AEFF',
                '#00FFA6'
            ],
            data: [@Html.Raw(Json.Serialize(Model.media)), @Html.Raw(Json.Serialize(Model.Mancante))]
                }]
            };

            let optionsCosPhi = {
                responsive: true,
                rotation: -90,
                circumference: 180
            };
    let ctxChartCosPhi = document.getElementById('graficoCosPhi').getContext('2d');

            let ChartCosPhi = new Chart(ctxChartCosPhi, {
                type: 'doughnut',
                data: dataCosPhi,
                options: optionsCosPhi
            });

    </script>


