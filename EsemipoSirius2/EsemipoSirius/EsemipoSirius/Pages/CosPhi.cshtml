@page
@model EsemipoSirius.Pages.CosPhiModel
@{
}

<form action="/CosPhi" method="get">
    <select name="NomeDevice">
        @foreach (var dispositivo in @Model.NomiDispositivi)
        {
            <option value=@dispositivo>@dispositivo</option>
        }
    </select>
    <br />
    <input type="submit" value="Submit" class="submit" />
</form>

<div class="CosPhi">
    <canvas id="graficoCosPhi" width="400" height="400">
    </canvas>
    <div class="container">
        <div class="row">
            <div class="col">
                0
            </div>
            <div class="col" id="colCosPhi">
                @Model.mediaCosPhi.ValoreCosPhi
            </div>
            <div class="col">
                1
            </div>
        </div>
    </div>
</div>

<div class="container mt-5">
    <h2>Tabella con Scroll</h2>
    <div class="table-scroll">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Numero</th>
                    <th>Data</th>
                    <th>CosPhi</th>
                    <th>Active Power</th>
                    <th>Reactive Power</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.efficienzaDispositivo)
                {
                    <tr>
                        <td>@a.Id</td>
                        <td>@a.Date</td>
                        <td>@a.CosPhi</td>
                        <td>@a.ActivePower</td>
                        <td>@a.ReactivePower</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<script>

    let dataCosPhi = {
            datasets: [{
        backgroundColor: [
            '#ffe400',
            '#cecece'
        ],
        data: [@Html.Raw(Json.Serialize(Model.mediaCosPhi.ValoreCosPhi)), @Html.Raw(Json.Serialize(Model.Mancante))]
            }]
        };

        let optionsCosPhi = {
            responsive: true,
            rotation: -90,
            circumference: 180,
            aspectRatio: 1
        };
    let ctxChartCosPhi = document.getElementById('graficoCosPhi').getContext('2d');

        let ChartCosPhi = new Chart(ctxChartCosPhi, {
            type: 'doughnut',
            data: dataCosPhi,
            options: optionsCosPhi
        });

</script>


