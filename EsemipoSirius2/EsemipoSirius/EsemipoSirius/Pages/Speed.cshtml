@page
@model EsemipoSirius.Pages.SpeedModel
@{
}
<form action="/Speed" method="get">
    <select name="NomeDevice">
        @foreach (var dispositivo in @Model.NomiDispositivi)
        {
            <option value=@dispositivo>@dispositivo</option>
        }
    </select>
    <br />
    <input type="submit" value="Submit" class="submit" />
</form>

<div class="graficiSpeed">
    <canvas id="graficoSpeedRotore" width="200" height="200"></canvas>
    <canvas id="graficoSpeedGeneratore" width="200" height="200"></canvas>
</div>

<script>

    let dataRotore = {
            datasets: [{
                label: '',
                backgroundColor: 'rgb(255, 99, 132)',
                borderColor: 'rgb(255, 99, 132)',
                data: @Html.Raw(Json.Serialize(Model.datiRotor))
            }]
        };

        let optionsRotore = {
            responsive: true,
            plugins: {
                title: {
                    display: true,
                    text: ''
                }
            }
        };

        let ctxRotore = document.getElementById('graficoSpeedRotore').getContext('2d');


        let ChartRotore = new Chart(ctxRotore, {
            type: 'scatter',
            data: dataRotore,
            options: optionsRotore
        });


    let dataGeneratore = {
            datasets: [{
             backgroundColor: 'rgb(54, 162, 235)',
             borderColor: 'rgb(54, 162, 235)',
             data: @Html.Raw(Json.Serialize(Model.datigenerator))
            }]
        };

        let optionsGeneratore = {
            responsive: true,
            plugins: {
                title: {
                    display: true,
                    text: ''
                }
            }
        };
        let ctxGeneratore = document.getElementById('graficoSpeedGeneratore').getContext('2d');

        let ChartGeneratore = new Chart(ctxGeneratore, {
            type: 'scatter',
            data: dataGeneratore,
            options: optionsGeneratore
        });

</script>