@page
@model EsemipoSirius.Pages.ActivePowerModel
@{
    ViewData["Title"] = "Active Power";
}

<div class="form-container">
    <h1>
        Monitoraggio Active Power della Pala Eolica
    </h1>
    <br/>
    <div>Seleziona un dispositivo:</div>
    <form action="/ActivePower" method="get" class="form-inline">
        <select name="NomeDevice" id="NomeDevices">
            @foreach (var dispositivo in @Model.NomiDispositivi)
            {
                <option value=@dispositivo>@dispositivo</option>
            }
        </select>
        <input type="submit" value="Invia" class="submit" />
    </form>
</div>

<div class="row-power">
    <div class="col-grafico">
        <div class="grafico-wrapper">
            <div class="titolo-grafico">ACTIVE POWER</div>
            <canvas id="graficoPower"></canvas>
        </div>
    </div>
    <div class="col-plant-img">
        <canvas id="graficoPlant"></canvas>
        <img src="~/img/1000087323.jpg" alt="Immagine" class="img-plant" />
    </div>
</div>

<p class="spiegazione">
    Questa pagina consente di monitorare la potenza attiva erogata dalla pala eolica, fornendo dati precisi per l’analisi delle prestazioni e l’ottimizzazione dell’efficienza energetica.
</p>
<script>

    let lablesPower = @Html.Raw(Json.Serialize(Model.Date));
    let dataPower = {
        labels: lablesPower,
        datasets: [{
            label: 'valore active power',
            backgroundColor: '#2563eb',
            borderColor: '#2563e',
            data: @Html.Raw(Json.Serialize(Model.ActivePower)),
        }]
    };

    let options = {
        responsive: true,
        plugins: {
            title: {
                display: false,
                text: 'ACTIVE POWER',
                font: {
                    size: 40
                },
                color: '#2563eb',
                padding: {
                    top: 10,
                    bottom: 30
                }
            }
        },
        aspectRatio: 1,
        scales: {
            x: {
                title: {
                    display: true,
                    text: 'Tempo',
                    font: {
                        size: 16
                    },
                    color: '#333'
                }
            },
            y: {
                title: {
                    display: true,
                    text: 'Potenza Attiva (kW)',
                    font: {
                        size: 16
                    },
                    color: '#333'
                }
            }
        }
    };

    let ctxPower = document.getElementById('graficoPower').getContext('2d');


    let myChartPower = new Chart(ctxPower, {
        type: 'bar',
        data: dataPower,
        options: options
    });

    let lablesElDisp = @Html.Raw(Json.Serialize(Model.Plant));
    let dataElDisp = {
        labels: lablesElDisp,
        datasets: [{
            label: 'Numero campi eolici',
            backgroundColor: '#2563eb',
            borderColor: '#2563eb',
            data: @Html.Raw(Json.Serialize(Model.NumDisp)),
        }]
    };

    let optionsElDisp = {
        responsive: true,
        plugins: {
            title: {
                display: true,
                text: 'Località',
                font: {
                    size: 40
                },
                color: '#2563eb',
                padding: {
                    top: 10,
                    bottom: 30
                }
            }
        },
        aspectRatio: 1,
        scales: {
            x: {
                title: {
                    display: true,
                    text: 'Luogo',
                    font: {
                        size: 16
                    },
                    color: '#333'
                }
            },
            y: {
                title: {
                    display: true,
                    text: 'Tempo',
                    font: {
                        size: 16
                    },
                    color: '#333'
                }
            }
        }
    };

      

    let ctxElDisp = document.getElementById('graficoPlant').getContext('2d');


    let myChartElDispositivi = new Chart(ctxElDisp, {
        type: 'bar',
        data: dataElDisp,
        options: optionsElDisp
    });

</script>
