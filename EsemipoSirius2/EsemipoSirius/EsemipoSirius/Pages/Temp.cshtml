@page
@model EsemipoSirius.Pages.TempModel
@{
    ViewData["Title"] = "Temperature";
}

<div class="form-container">
    <h1>
        Monitoraggio Termico e Pressione Olio
    </h1>
    <br />
    <div>Seleziona un dispositivo:</div>
    <form action="/Temp" method="get" class="form-inline">
        <select name="NomeDevice" id="NomeDevices">
            @foreach (var dispositivo in @Model.NomiDispositivi)
            {
                <option value=@dispositivo>@dispositivo</option>
            }
        </select>
        <input type="submit" value="Invia" class="submit" />
    </form>
</div>

<div class="grafico temp1">
    <div class="titolo-grafico">TEMPERATURE</div>
    <canvas id="graficoTemp"></canvas>
</div>

<div class="container temp2">
    <div class="row">
        <div class="col">
            <div class="titolo-grafico">TEMPERATURA OLIO</div>
            <canvas id="graficoOilTemp" width="200" height="200"></canvas>
        </div>
        <div class="col">
            <div class="titolo-grafico">PRESSIONE OLIO</div>
            <canvas id="graficoOilPress" width="200" height="200"></canvas>
        </div>
    </div>
</div>

<p class="spiegazione">
    Questa pagina consente di monitorare le principali temperature della pala eolica e la pressione dell’olio, fornendo dati affidabili per l’analisi termica e il controllo delle condizioni operative.
</p>

<script>

    let dataTemp = {
        labels: @Html.Raw(Json.Serialize(Model.Date)),
        datasets: [{
            type: 'line',
            label: 'Temperatura hub',
            data: @Html.Raw(Json.Serialize(Model.hubTemp)),
            borderColor: 'rgba(0, 145, 215, 0.8)',
            backgroundColor: 'rgba(0, 145, 215, 0.8)',
            pointRadius: 0
        },{
            type: 'line',
            label: 'Temperatura top',
            data: @Html.Raw(Json.Serialize(Model.TopTemp)),
            borderColor: 'rgba(227, 187, 0, 0.8)',
            backgroundColor: 'rgba(227, 187, 0, 0.8)',
            pointRadius: 0
        }, {
            type: 'line',
            label: 'Temperatura ambientale',
            data: @Html.Raw(Json.Serialize(Model.AmbTemp)),
            borderColor: 'rgba(9, 193, 7, 0.8)',
            backgroundColor: 'rgba(9, 193, 7, 0.8)',
            pointRadius: 0
        }]
    };

    let optionsTemp = {
        responsive: true,
        aspectRatio: 1,
        plugins: {
            title: {
                display: true,
                text: ''
            },
            zoom: {
                pan: {
                    enabled: true,
                    mode: 'xy'
                },
                zoom: {
                    wheel: { enabled: true },
                    pinch: { enabled: true },
                    mode: 'x'
                }
            }
        },
        scales: {
            x: {
                title: {
                    display: true,
                    text: 'Tempo'
                }
            },
            y: {
                title: {
                    display: true,
                    text: 'Temperatura (°C)'
                }
            }
        }
    };

    let ctxTemp = document.getElementById('graficoTemp').getContext('2d');


    let myChartTemp = new Chart(ctxTemp, {
        type: 'line',
        data: dataTemp,
        options: optionsTemp
    });

        let dataOilTemp = {
        labels: @Html.Raw(Json.Serialize(Model.Date)),
        datasets: [{
            type: 'line',
            label: 'Temperatura Olio',
            data: @Html.Raw(Json.Serialize(Model.OilTemp)),
            borderColor: 'rgba(255, 205, 0, 0.8)',
            backgroundColor: 'rgba(255, 205, 0, 0.8)',
            pointRadius: 0
        }]
    };

        let optionsOilTemp = {
        responsive: true,
        aspectRatio: 1,
        plugins: {
            title: {
                display: true,
                text: ''
            },
            zoom: {
                pan: {
                    enabled: true,
                    mode: 'xy'
                },
                zoom: {
                    wheel: { enabled: true },
                    pinch: { enabled: true },
                    mode: 'x'
                }
            }
        },
        scales: {
            x: {
                title: {
                    display: true,
                    text: 'Tempo'
                }
            },
            y: {
                title: {
                    display: true,
                    text: 'Temperatura (°C)'
                }
            }
        }
    };

    let ctxOilTemp = document.getElementById('graficoOilTemp').getContext('2d');


    let myChartOilTemp = new Chart(ctxOilTemp, {
        type: 'line',
        data: dataOilTemp,
        options: optionsOilTemp
    });

        let dataOilPress = {
        labels: @Html.Raw(Json.Serialize(Model.Date)),
        datasets: [{
            type: 'line',
            label: 'Pressione Olio',
            data: @Html.Raw(Json.Serialize(Model.OilPress)),
            borderColor: 'rgba(255, 205, 0, 0.8)',
            backgroundColor: 'rgba(255, 205, 0, 0.8)',
            pointRadius: 0
        }]
    };

     let optionsOilPress = {
        responsive: true,
        aspectRatio: 1,
        plugins: {
            title: {
                display: true,
                text: ''
            },
            zoom: {
                pan: {
                    enabled: true,
                    mode: 'xy'
                },
                zoom: {
                    wheel: { enabled: true },
                    pinch: { enabled: true },
                    mode: 'x'
                }
            }
        },
        scales: {
            x: {
                title: {
                    display: true,
                    text: 'Tempo'
                }
            },
            y: {
                title: {
                    display: true,
                    text: 'Pressione (psi)'
                }
            }
        }
    };

    let ctxOilPress = document.getElementById('graficoOilPress').getContext('2d');


    let myChartOilPress = new Chart(ctxOilPress, {
        type: 'line',
        data: dataOilPress,
        options: optionsOilPress
    });

</script>


