@page
@model EsemipoSirius.Pages.WindModel
@{
    ViewData["Title"] = "Wind dir";
}

<div class="form-container">
    <h1>
        Direzione del Vento
    </h1>
    <br />
    <div>Seleziona un dispositivo:</div>
    <form action="/Wind" method="get" class="form-inline">
        <select name="NomeDevice" id="NomeDevices">
            @foreach (var dispositivo in @Model.NomiDispositivi)
            {
                <option value=@dispositivo>@dispositivo</option>
            }
        </select>
        <input type="submit" value="Invia" class="submit" />
    </form>
</div>

<div class="Wind">
    <div class="titolo-grafico">DIREZIONE PALA EOLICA</div>
    <canvas id="graficoDir"></canvas>
</div>

<p class="spiegazione">
    Questa pagina permette di visualizzare e analizzare in tempo reale la direzione del vento, fornendo dati fondamentali per la gestione ottimale della pala eolica e per l’ottimizzazione delle prestazioni del sistema.
</p>

<script>

    const datiCorretti = [
      { x: 0, y: 0 },
      { x: 360, y: 360 }
    ];

    let ctx = document.getElementById('graficoDir').getContext('2d');
    let data = {
        datasets: [{
             type: 'scatter',
            label: 'Direzione (°) - MEDIA',
            backgroundColor: 'rgba(42, 91, 232, 1)',
            borderColor: 'rgba(42, 91, 232, 1)',
            data: @Html.Raw(Json.Serialize(Model.MediadatiDir)),
            yAxisID: 'y'
        }, {
            type: 'line',
            label: 'POSIZIONE CORRETTA',
            backgroundColor: 'rgba(255, 0, 0, 1)',
            borderColor: 'rgba(255, 0, 0, 1)',
            data: datiCorretti,
            borderDash: [5, 5],
            pointRadius: 0,
            borderWidth: 5,
            yAxisID: 'y'
        }, {
            type: 'scatter',
            label: 'Direzione (°)',
            backgroundColor: 'rgba(115, 195, 255, 0.2)',
            borderColor: 'rgba(115, 195, 255, 0.2)',
            data: @Html.Raw(Json.Serialize(Model.datiDir)),
            yAxisID: 'y'
        }]
    };

    let options = {
        responsive: true,
        aspectRatio: 1,
        plugins: {
            title: {
                display: true,
                text: ''
            }
        },
        scales: {
        x: {
            title: {
                display: true,
                text: 'direzione pala eolica (°)'
            }
        },
        y: {
            title: {
                display: true,
                text: 'direzione vento (°)'
            }
        }
    }
    };
    let ChartWind = new Chart(ctx, {
        type: 'scatter',
        data: data,
        options: options,
    });
</script>
